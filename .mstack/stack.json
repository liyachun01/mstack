{
  "project": "mcp-stack",
  "preset": "solo",
  "capture": {
    "enabled": true,
    "sink": "anytype-taskboard",
    "harnesses": [
      "claude"
    ],
    "events": [
      "UserPromptSubmit",
      "Stop"
    ]
  },
  "taskboard": {
    "table": "mstack",
    "workers": [
      "claude-desktop",
      "codex-desktop"
    ],
    "link": {
      "provider": "linear",
      "mode": "full",
      "scope": "mine",
      "workspace": "yyyymmdd",
      "team": "MST",
      "key_entry": 1,
      "credential_file": ".mstack/secrets/linear-api-key"
    },
    "backend": "linear",
    "auto": false,
    "private": false,
    "docs_url": "https://github.com/liyachun01/mstack/blob/main/"
  },
  "joints": {
    "compress": "headroom",
    "memory.long": "graphify"
  },
  "hub": {
    "store": "file",
    "resend_minutes": 5
  }
}
