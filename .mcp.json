{
  "mcpServers": {
    "serena": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/oraios/serena@v2.1.0",
        "serena",
        "start-mcp-server",
        "--project-from-cwd",
        "--context",
        "claude-code",
        "--open-web-dashboard",
        "False"
      ]
    },
    "mstack_headroom": {
      "type": "stdio",
      "command": "python3",
      "args": [
        "/home/developer/workspace/mstack/integrations/tenants/launch.py",
        "--project",
        "/home/developer/workspace/mstack",
        "--tool",
        "headroom"
      ]
    },
    "mstack_graphify": {
      "type": "stdio",
      "command": "python3",
      "args": [
        "/home/developer/workspace/mstack/integrations/tenants/launch.py",
        "--project",
        "/home/developer/workspace/mstack",
        "--tool",
        "graphify"
      ]
    }
  }
}
