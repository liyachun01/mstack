{
  "config": {
    "adminAddr": "off",
    "statsAddr": "off",
    "readinessAddr": "off",
    "enableIpv6": false,
    "workerThreads": 1,
    "storage": {
      "mode": "readOnly"
    },
    "logging": {
      "level": "warn",
      "filter": "false"
    }
  },
  "gateways": {
    "foundation": {
      "port": 4000,
      "apiKey": {
        "mode": "strict",
        "keys": [
          {
            "keyHash": "sha256:__CLIENT_KEY_SHA256__",
            "metadata": {
              "user": "local-foundation"
            }
          }
        ]
      }
    }
  },
  "routes": [
    {
      "name": "health",
      "gateways": [
        "foundation"
      ],
      "matches": [
        {
          "path": {
            "exact": "/healthz"
          }
        }
      ],
      "policies": {
        "directResponse": {
          "status": 200
        }
      }
    },
    {
      "name": "graphify",
      "gateways": [
        "foundation"
      ],
      "matches": [
        {
          "path": {
            "exact": "/mcp/graphify"
          }
        }
      ],
      "policies": {
        "mcpAuthorization": {
          "rules": [
            "mcp.tool.target == \"graphify\" && mcp.tool.name in [\"query_graph\", \"get_node\", \"get_neighbors\", \"get_community\", \"god_nodes\", \"graph_stats\", \"shortest_path\"]"
          ]
        }
      },
      "backends": [
        {
          "mcp": {
            "targets": [
              {
                "name": "graphify",
                "mcp": {
                  "host": "http://graphify-http:8000/mcp/"
                },
                "policies": {
                  "backendAuth": {
                    "key": {
                      "value": {
                        "file": "/run/secrets/graphify-backend-key"
                      },
                      "location": {
                        "header": {
                          "name": "authorization",
                          "prefix": "Bearer "
                        }
                      }
                    }
                  }
                }
              }
            ],
            "statefulMode": "stateful",
            "prefixMode": "always",
            "failureMode": "failClosed",
            "dnsRebindingProtection": true
          }
        }
      ]
    },
    {
      "name": "codegraph",
      "gateways": [
        "foundation"
      ],
      "matches": [
        {
          "path": {
            "exact": "/mcp/codegraph"
          }
        }
      ],
      "policies": {
        "mcpAuthorization": {
          "rules": [
            "mcp.tool.target == \"codegraph\" && mcp.tool.name == \"codegraph_explore\""
          ]
        }
      },
      "backends": [
        {
          "mcp": {
            "targets": [
              {
                "name": "codegraph",
                "mcp": {
                  "host": "http://codegraph-http:8000/mcp"
                },
                "policies": {
                  "backendAuth": {
                    "key": {
                      "value": {
                        "file": "/run/secrets/codegraph-backend-key"
                      },
                      "location": {
                        "header": {
                          "name": "authorization",
                          "prefix": "Bearer "
                        }
                      }
                    }
                  }
                }
              }
            ],
            "statefulMode": "stateful",
            "prefixMode": "always",
            "failureMode": "failClosed",
            "dnsRebindingProtection": true
          }
        }
      ]
    },
    {
      "name": "mcp-not-configured",
      "gateways": [
        "foundation"
      ],
      "matches": [
        {
          "path": {
            "pathPrefix": "/mcp"
          }
        }
      ],
      "policies": {
        "directResponse": {
          "status": 503
        }
      }
    },
    {
      "name": "not-found",
      "gateways": [
        "foundation"
      ],
      "policies": {
        "directResponse": {
          "status": 404
        }
      }
    }
  ]
}
