{
  "note": "Secret and private files mstack expects on a working machine. Names only, never values. None of them are in git. Restore them from your own backup on a new machine; `mstack hydrate` reports which are missing.",
  "files": [
    {"path": ".mstack/private.json", "for": "real names behind the repo's {{mstack:…}} placeholders (copy .mstack/private.example.json)"},
    {"path": ".secrets/linear.csv", "for": "Linear API keys, one row per workspace entry (mstack board link)"},
    {"path": ".secrets/anytype.csv", "for": "Anytype API keys"},
    {"path": ".secrets/agents.csv", "for": "agent/provider credentials"},
    {"path": ".secrets/postgres_password", "for": "shared PostgreSQL superuser"},
    {"path": ".secrets/postgres/mstack_orchestrator.password", "for": "orchestrator database owner (issue mirror)"},
    {"path": ".secrets/postgres/mstack_viewer.password", "for": "read-only viewer (WhoDB)"},
    {"path": ".secrets/windmill_password", "for": "Windmill database login"},
    {"path": ".secrets/agentgateway-client-key", "for": "agentgateway client key"},
    {"path": ".secrets/agentgateway/ui-password", "for": "agentgateway owner UI"},
    {"path": ".secrets/graphify-http-backend-key", "for": "Graphify HTTP backend"},
    {"path": ".secrets/codegraph-http-backend-key", "for": "CodeGraph HTTP backend"},
    {"path": ".secrets/n8n_password", "for": "n8n database login"},
    {"path": ".secrets/n8n_encryption_key", "for": "n8n credential encryption"},
    {"path": ".secrets/n8n_runner_token", "for": "n8n task runner"},
    {"path": ".secrets/n8n_user_password", "for": "n8n owner login"},
    {"path": ".secrets/basic_memory_password", "for": "Basic Memory database login"},
    {"path": ".secrets/notion/apikey.csv", "for": "Notion API key (optional)"},
    {"path": ".mstack/secrets/linear-api-key", "for": "mstack board's own Linear key (copied from linear.csv entry 1)"},
    {"path": ".mstack/secrets/mstack-headroom-token", "for": "mstack's Headroom tenant"},
    {"path": ".mstack/secrets/mstack-graphify-token", "for": "mstack's Graphify tenant"},
    {"path": "infra/windmill/state/mstack-token", "for": "Windmill API token for the mstack workspace"},
    {"path": "infra/windmill/state/mstack-mcp-token", "for": "Windmill MCP token"}
  ],
  "state_folders": "infra/*/state/ hold runtime state and service tokens; restore them from backup rather than recreating, or services lose their data."
}
