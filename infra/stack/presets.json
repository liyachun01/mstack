    "events": {
      "model": "codex",
      "knowledge": "anytype",
      "jobs": "windmill",
      "tools": [
        "codex",
        "anytype",
        "windmill",
        "garage",
        "n8n"
      ],
      "purpose": "App event intake followed by reviewed jobs"
    }
  },
  "tool_purposes": {
    "codex": "Interactive reasoning, source edits, local tests and project tool calls",
    "anytype": "Canonical docs/objects/tasks in the authenticated project channel",
    "ai-memory": "Explicit secondary memory only; no automatic Anytype mirror",
    "basic-memory": "Explicit secondary Markdown context",
    "graphify": "Relationships in a qualified corpus",
    "codegraph": "Symbols/callers within the qualified index",
    "windmill": "Reviewed execution, schedules, retries and durable run records",
    "n8n": "App connectors/event intake and authorized delivery",
    "garage": "Scoped object artifacts, not arbitrary host sharing",
    "agentgateway": "Optional qualified MCP routes for multiple callers",
    "headroom": "On-demand compression and retrieval of selected tool output; not automatic chat compaction"
  },
  "boundaries": {
    "memory_broadcast": false,
    "background_sync": false,
    "automatic_installation": false,
    "automatic_indexing": false,
    "paid_model_fallback": false,
    "live_trading": false,
    "project_labels_are_RBAC": false
  }
}
