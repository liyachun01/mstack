  "collection": "Task Board",
  "chat": "Agent Log",
  "linear_sync": {
    "$comment": "Design intent only; no Linear token or sync job exists yet.",
    "scope": "assignee = me OR creator = me",
    "status_map": {
      "Backlog": "backlog",
      "Todo": "unstarted",
      "In Progress": "started",
      "In Review": "started",
      "Done": "completed",
      "Canceled": "canceled"
    },
    "priority_map": {
      "Urgent": 1,
      "High": 2,
      "Medium": 3,
      "Low": 4
    },
    "conflict_rule": "Anytype wins for agent fields; newest updated_at wins for title/status/priority/due"
  },
  "credential_file": ".mstack/secrets/anytype-taskboard-test.key",
  "naming": {
    "$comment": "Issue titles: [APP][KIND] description. APP is a short code per app in the repo (taskboard.apps); KIND is one of the task_kind options.",
    "kinds": [
      "FEAT",
      "BUG",
      "CHORE",
      "DOCS",
      "TEST",
      "REFACTOR",
      "PERF",
      "SEC",
      "OPS"
    ]
  }
