{
  "$comment": "Shared Anytype task board channel, owned by mstack. Each project gets its own table (a query filtered on Project). Provisioned by integrations/agents/anytype_taskboard.py; operated by integrations/orchestrator.",
  "channel": "mstack",
  "type": {
    "key": "agent_task",
    "name": "Agent Task",
    "plural_name": "Agent Tasks",
    "emoji": "🧭",
    "default_view": "kanban"
  },
  "properties": [
    {
      "key": "task_project",
      "name": "Project",
      "format": "select",
      "section": "featured",
